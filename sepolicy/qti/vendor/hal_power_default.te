typeattribute hal_power_default mlstrustedsubject;

allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

hal_client_domain(hal_power_default, vendor_hal_oplus_charger)

# ADPF hint sessions set scheduling on client threads, which requires CAP_SYS_NICE
allow hal_power_default self:capability sys_nice;
allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default surfaceflinger:process setsched;
allow hal_power_default hal_graphics_composer_default:process setsched;
allow hal_power_default system_server:process setsched;

hal_client_domain(hal_power_default, vendor_hal_oplus_touch)

binder_call(hal_power_default, hal_oplus_touch_aidl);

rw_dir_file(hal_power_default, proc)
rw_dir_file(hal_power_default, proc_sched)
rw_dir_file(hal_power_default, sysfs_devices_system_cpu)
rw_dir_file(hal_power_default, vendor_proc_display)
rw_dir_file(hal_power_default, vendor_sysfs_msm_perf)
rw_dir_file(hal_power_default, vendor_sysfs_sde_crtc)
rw_dir_file(hal_power_default, sysfs_devfreq)
rw_dir_file(hal_power_default, vendor_sysfs_devfreq)
rw_dir_file(hal_power_default, vendor_sysfs_kgsl)
