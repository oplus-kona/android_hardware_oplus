cc_binary {
    name: "vendor.lineage.touch-service.oplus",
    init_rc: ["vendor.lineage.touch-service.oplus.rc"],
    vintf_fragments: select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "ENABLE_GM"), {
        true: ["vendor.lineage.touch-service.oplus-gm.xml"],
        default: [],
    }) + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "ENABLE_HTPR"), {
        true: ["vendor.lineage.touch-service.oplus-htpr.xml"],
        default: [],
    }) + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "ENABLE_TG"), {
        false: [],
        default: ["vendor.lineage.touch-service.oplus-tg.xml"],
    }),
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "GloveMode.cpp",
        "HighTouchPollingRate.cpp",
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
    include_dirs: select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "INCLUDE_DIR"), {
        any @ flag_val: [flag_val],
        default: [],
    }),
    cflags: [
        "-Wall",
        "-Werror",
    ] + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "ENABLE_GM"), {
        true: ["-DENABLE_GM=true"],
        default: ["-DENABLE_GM=false"],
    }) + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "ENABLE_HTPR"), {
        true: ["-DENABLE_HTPR=true"],
        default: ["-DENABLE_HTPR=false"],
    }) + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "ENABLE_TG"), {
        false: ["-DENABLE_TG=false"],
        default: ["-DENABLE_TG=true"],
    }) + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "GLOVE_MODE_NODE"), {
        any @ node: ["-DGLOVE_MODE_NODE=\"" + node + "\""],
        default: ["-DGLOVE_MODE_NODE=\"/proc/touchpanel/glove_mode_enable\""],
    }) + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "HTPR_ENABLE_NODE"), {
        any @ node: ["-DHTPR_ENABLE_NODE=\"" + node + "\""],
        default: ["-DHTPR_ENABLE_NODE=\"/proc/touchpanel/game_switch_enable\""],
    }) + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "HTPR_ENABLE_VALUE"), {
        any @ value: ["-DHTPR_ENABLE_VALUE=\"" + value + "\""],
        default: ["-DHTPR_ENABLE_VALUE=\"1\""],
    }) + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "GESTURE_ENABLE_INDEP_NODES"), {
        any @ nodes: ["-DGESTURE_ENABLE_INDEP_NODES=\"" + nodes + "\""],
        default: ["-DGESTURE_ENABLE_INDEP_NODES=\"/proc/touchpanel/double_tap_enable_indep\""],
    }),
}
