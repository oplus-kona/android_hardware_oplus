cc_library_static {
    name: "power-ext-oplus",
    defaults: ["android.hardware.power-ndk_shared"],
    vendor: true,
    srcs: [
        "power-mode.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ] + select(soong_config_variable("OPLUS_LINEAGE_TOUCH_HAL", "GESTURE_ENABLE_INDEP_NODES"), {
        any @ nodes: ["-DGESTURE_ENABLE_INDEP_NODES=\"" + nodes + "\""],
        default: ["-DGESTURE_ENABLE_INDEP_NODES=\"/proc/touchpanel/double_tap_enable_indep\""],
    }),
    cppflags: select(soong_config_variable("power_libperfmgr", "mode_extension_lib"), {
        any: ["-DLIBPERFMGR_EXT"],
        default: [],
    }),
    shared_libs: [
        "libbase",
    ],
}
